# Unidades que participam da batalha.
tank Atlas {
    gun MainGun
}
team Blue {
    Atlas
}
submarine Coral {
    torpedo Dardo
}
team Red {
    Coral
}
battle Training {
    Blue vs Red
}
# Quatro ordens de movimento formam um quadrado.
move Atlas 20 20
move Atlas 60 20
move Atlas 60 60
move Atlas 20 60
