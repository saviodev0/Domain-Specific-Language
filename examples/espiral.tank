# Cenario com tanque, submarino, aeronave, equipes e comandos condicionais.
tank Guard {
    gun Cannon
}
aircraft Hawk {
    missile Sidewinder
}
submarine DeepOne {
    torpedo Torpedo1
    torpedo Torpedo2
}
team Blue {
    Guard
    Hawk
}
team Red {
    DeepOne
}
battle Spiral {
    Blue vs Red
}
move Guard 30 30
move Hawk 20 60
move DeepOne 150 70
if "start" == "start" {
    sonar Guard
}
repeat 2 {
    move Guard 40 30
    move Guard 50 40
}
